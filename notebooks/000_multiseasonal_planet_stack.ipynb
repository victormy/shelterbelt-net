    "# 000 -- Multi-seasonal Planet Stack\n",
    "\n",
    "Stack monthly RGB Planet basemaps (April, July, October) into a single multi-temporal raster per tile."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a1b1c1d1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pipeline\n",
    "\n",
    "def progress(frac, msg):\n",
    "    print(f\"[{frac:.0%}] {msg}\")\n",
    "\n",
    "pipeline.stack_multiseasonal(progress=progress)"
   ]
  }
